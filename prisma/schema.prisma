// Whetstone data schema.
// Source of truth: 05-technical-foundation-stack-schema-auth.md (+ 05b addendum).
// Prisma manages table structure/migrations; Supabase RLS policies + auth triggers
// live separately under supabase/migrations/ (Prisma has no native RLS concept).
//
// Tables and columns are mapped to snake_case so the hand-written RLS SQL in
// supabase/migrations/ references the same identifiers Postgres actually has.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is the engine Vercel's
  // serverless runtime (Amazon Linux) needs — without it, deployed functions
  // fail with "Query engine binary not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADVISOR
  OPS_ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_MORE_INFO
}

model User {
  // id mirrors the Supabase auth.users id (set by the auth trigger, not cuid()).
  id              String           @id
  email           String           @unique
  role            UserRole
  // Account & profile (screens 9c/14c). These live on User (not a role profile)
  // so they work for a customer who hasn't created a CustomerProfile yet.
  // users is owner+OPS-only under RLS, so they are never publicly exposed.
  fullName        String?          @map("full_name")
  firstName       String?          @map("first_name")
  lastName        String?          @map("last_name")
  phone           String?          @map("phone")
  avatarUrl       String?          @map("avatar_url")
  // Per-key notification toggles (role-agnostic map, e.g. {"newMessages": true}).
  // Defaults live in code (lib/notifications) so an absent value reads as the default.
  notificationPrefs Json?          @map("notification_prefs")
  // Hashed single-use 2FA recovery codes (never the plaintext). Consuming one
  // disables the TOTP factor so a user who lost their authenticator can sign in.
  mfaRecoveryCodes  String[]       @default([]) @map("mfa_recovery_codes")
  createdAt       DateTime         @default(now()) @map("created_at")
  advisorProfile  AdvisorProfile?
  customerProfile CustomerProfile?
  threadReads     ThreadRead[]

  @@map("users")
}

model IndustryTaxonomy {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  // self-relation for industry > sub-specialty structure
  parentId String? @map("parent_id")
  parent   IndustryTaxonomy?  @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children IndustryTaxonomy[] @relation("TaxonomyHierarchy")

  customerProfiles CustomerProfile[]
  needs            Need[]
  advisors         AdvisorProfile[]  @relation("AdvisorSpecialties")

  @@index([parentId])
  @@map("industry_taxonomy")
}

model AdvisorProfile {
  id                      String             @id @default(cuid())
  userId                  String             @unique @map("user_id")
  user                    User               @relation(fields: [userId], references: [id])
  bio                     String
  headline                String? // short RelevanceExplainer seed line
  // Free-text escape hatch when the taxonomy's "Other" doesn't capture an
  // advisor's industry/capability — reviewed by ops, who can extend the taxonomy.
  otherSpecialties        String?            @map("other_specialties")
  yearsExperience         Int                @map("years_experience")
  verificationStatus      VerificationStatus @default(PENDING) @map("verification_status")
  identityCheckPassed     Boolean            @default(false) @map("identity_check_passed")
  insuranceCoverageActive Boolean            @default(false) @map("insurance_coverage_active")
  avatarUrl               String?            @map("avatar_url")
  // Account & profile (screen 14c): release held earnings weekly (payout schedule
  // preference), and a soft-deactivation timestamp for "leave the platform".
  weeklyPayouts           Boolean            @default(true) @map("weekly_payouts")
  deactivatedAt           DateTime?          @map("deactivated_at")
  // Stripe Connect (Express) account that receives payouts. Set during payout onboarding.
  stripeAccountId         String?            @map("stripe_account_id")
  specialtyTags           IndustryTaxonomy[] @relation("AdvisorSpecialties")
  availabilitySlots       AvailabilitySlot[]
  verificationRecords     VerificationRecord[]
  bookings                Booking[]
  createdAt               DateTime           @default(now()) @map("created_at")

  @@index([verificationStatus])
  @@map("advisor_profiles")
}

model VerificationRecord {
  id         String         @id @default(cuid())
  advisorId  String         @map("advisor_id")
  advisor    AdvisorProfile @relation(fields: [advisorId], references: [id])
  type       String // "reference_call" | "license_check" | "id_check" — evidence trail (B2)
  notes      String
  reviewedBy String         @map("reviewed_by") // ops staff user id
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([advisorId])
  @@map("verification_records")
}

model AvailabilitySlot {
  id        String         @id @default(cuid())
  advisorId String         @map("advisor_id")
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [id])
  startsAt  DateTime       @map("starts_at")
  endsAt    DateTime       @map("ends_at")
  isBooked  Boolean        @default(false) @map("is_booked")
  session   Session?

  @@index([advisorId])
  @@map("availability_slots")
}

model CustomerProfile {
  id           String           @id @default(cuid())
  userId       String           @unique @map("user_id")
  user         User             @relation(fields: [userId], references: [id])
  businessName String           @map("business_name")
  industryId   String           @map("industry_id")
  industry     IndustryTaxonomy @relation(fields: [industryId], references: [id])
  // Stripe customer id for saved payment methods (screen 9c). Nullable — set only
  // once a customer saves a card. customer_profiles is owner+OPS-only under RLS.
  stripeCustomerId String? @map("stripe_customer_id")
  needs        Need[]
  bookings     Booking[]

  @@map("customer_profiles")
}

model Need {
  id             String           @id @default(cuid())
  // Signup-first (A2): a need is owned by a CustomerProfile from creation. This
  // was nullable to support a "guest need" posted before an account existed; that
  // flow is gone, and the RLS policy on needs (0002) already scopes rows by
  // customer_id -> auth.uid(), which an ownerless row could never satisfy.
  customerId     String           @map("customer_id")
  customer       CustomerProfile  @relation(fields: [customerId], references: [id])
  industryId     String           @map("industry_id")
  industry       IndustryTaxonomy @relation(fields: [industryId], references: [id])
  problemArea    String           @map("problem_area")
  description    String
  status         String           @default("open") // "open" | "matched" | "closed"
  createdAt      DateTime         @default(now()) @map("created_at")
  matchDecisions MatchDecision[]
  bookings       Booking[]

  @@index([status])
  @@map("needs")
}

model MatchDecision {
  id                 String   @id @default(cuid())
  needId             String   @map("need_id")
  need               Need     @relation(fields: [needId], references: [id])
  advisorsConsidered String[] @map("advisors_considered") // advisor profile ids — structured, not free text
  advisorChosenId    String   @map("advisor_chosen_id")
  reason             String
  decidedBy          String   @map("decided_by") // ops staff user id
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([needId])
  @@map("match_decisions")
}

model Package {
  id               String    @id @default(cuid())
  name             String
  sessionCount     Int       @map("session_count")
  scopeDescription String    @map("scope_description")
  priceCents       Int       @map("price_cents")
  // Multi-currency: platform serves customers worldwide. AUD is the default.
  currency         String    @default("AUD") // ISO 4217
  active           Boolean   @default(true)
  bookings         Booking[]

  @@map("packages")
}

model Booking {
  id                         String          @id @default(cuid())
  customerId                 String          @map("customer_id")
  customer                   CustomerProfile @relation(fields: [customerId], references: [id])
  advisorId                  String          @map("advisor_id")
  advisor                    AdvisorProfile  @relation(fields: [advisorId], references: [id])
  packageId                  String          @map("package_id")
  package                    Package         @relation(fields: [packageId], references: [id])
  // The challenge this booking was made to address. createBooking already
  // received a needId, checked the client owned it, read its industry off it —
  // and then dropped it, so nothing tied a booking to the brief behind it. The
  // advisor screen had to guess with "the client's most recent need", which
  // hands an advisor someone else's brief the moment a client posts a second
  // one. Nullable: a client can book an advisor directly without posting a
  // challenge first, and older rows may not be resolvable.
  needId                     String?         @map("need_id")
  need                       Need?           @relation(fields: [needId], references: [id])
  // Copied at booking time — protects the bounded-scope guarantee even if the
  // package definition changes later (liability-containment design decision).
  sessionCount               Int             @map("session_count")
  scopeDescription           String          @map("scope_description")
  priceCents                 Int             @map("price_cents") // copied at booking time
  currency                   String          @default("AUD") @map("currency") // copied at booking time
  status                     String          @default("pending_payment")
  // "pending_payment" | "confirmed" | "in_progress" | "awaiting_confirmation"
  //   | "completed" | "cancelled" | "disputed"
  // Completion is two-sided: the advisor marks the work done (-> awaiting_confirmation),
  // then the client accepts (-> completed), and only that acceptance releases the held
  // payment. See lib/actions/completion.ts for the transitions and their guards.
  // Must be true before status can become "confirmed" — enforced in app logic, not just schema.
  insuranceCoverageConfirmed Boolean         @default(false) @map("insurance_coverage_confirmed")
  createdAt                  DateTime        @default(now()) @map("created_at")
  // Completion trail. advisorCompletedAt starts the client's acceptance window;
  // completionRemindedAt is the day-3 nudge stamp (set once, same atomic-claim
  // pattern as the session reminders); clientConfirmedAt records acceptance —
  // whether the client clicked it or the day-7 sweep did it for them.
  advisorCompletedAt         DateTime?       @map("advisor_completed_at")
  completionRemindedAt       DateTime?       @map("completion_reminded_at")
  clientConfirmedAt          DateTime?       @map("client_confirmed_at")
  completionAutoAccepted     Boolean         @default(false) @map("completion_auto_accepted")
  // Unpaid-booking trail, mirroring the completion stamps above. A booking left
  // at "pending_payment" gets one nudge (paymentRemindedAt, set once by the same
  // atomic-claim pattern) and is then cancelled by the sweep, which stamps
  // paymentExpiredAt and releases the reserved slot. The stamp is what separates
  // "cancelled because nobody paid" from "cancelled by an ops refund" — both
  // land on status "cancelled".
  paymentRemindedAt          DateTime?       @map("payment_reminded_at")
  paymentExpiredAt           DateTime?       @map("payment_expired_at")
  sessions                   Session[]
  payment                    Payment?
  review                     Review?
  outcomeSurvey              OutcomeSurvey?
  disputes                   Dispute[]
  messages                   Message[]
  threadReads                ThreadRead[]

  @@index([customerId])
  @@index([advisorId])
  @@index([status])
  @@index([needId])
  @@map("bookings")
}

model Session {
  id           String   @id @default(cuid())
  bookingId    String   @map("booking_id")
  booking      Booking  @relation(fields: [bookingId], references: [id])
  scheduledAt  DateTime @map("scheduled_at")
  // The availability slot this session reserved, when it came from one. Set at
  // booking time so releasing a slot is exact: without it, freeing a slot means
  // guessing from advisorId + startsAt, which quietly unbooks the wrong row if an
  // advisor ever has two slots at the same instant. Nullable because a
  // multi-session package schedules its later sessions by coordination.
  slotId       String?  @unique @map("slot_id")
  slot         AvailabilitySlot? @relation(fields: [slotId], references: [id])
  status       String   @default("scheduled") // "scheduled" | "completed" | "no_show" | "rescheduled"
  // Set when the advisor records the outcome above. A booking can only be marked
  // complete once every one of its sessionCount sessions has left "scheduled".
  outcomeAt    DateTime? @map("outcome_at")
  videoCallUrl String?  @map("video_call_url")
  // Reminder dispatch stamps (session-reminder cron). Null = not yet sent; set
  // atomically when the reminder for that window goes out, so it sends once.
  reminded24hAt DateTime? @map("reminded_24h_at")
  reminded1hAt  DateTime? @map("reminded_1h_at")

  @@index([bookingId])
  @@map("sessions")
}

// How far through a booking's thread one person has read.
//
// Message itself carries no read state — it never has — so "unread" had no
// answer in the database, and an advisor had no way to see a client had written
// to them without opening every booking. One row per person per thread, holding
// the instant they last had it open; anything newer from the other party counts
// as unread. An absent row means never opened, so everything from the other
// side is unread — NOT zero.
//
// Per-thread rather than per-message: a bell needs a count, and this answers it
// without a receipt row for every message ever sent. Per-message receipts are
// what read ticks inside the thread would need, and can be added later without
// unpicking this.
model ThreadRead {
  id         String   @id @default(cuid())
  bookingId  String   @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  lastReadAt DateTime @map("last_read_at")

  // One marker per person per thread — the upsert on thread open depends on it.
  @@unique([bookingId, userId])
  @@index([userId])
  @@map("thread_reads")
}

model Message {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String   @map("sender_id") // user id
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("messages")
}

model Payment {
  id                    String  @id @default(cuid())
  bookingId             String  @unique @map("booking_id")
  booking               Booking @relation(fields: [bookingId], references: [id])
  amountCents           Int     @map("amount_cents")
  currency              String  @default("AUD") // ISO 4217, matches the booking
  status                String  @default("held") // "held" | "released" | "refunded" | "partial_refund"
  stripePaymentIntentId String  @map("stripe_payment_intent_id")
  // Platform commission withheld from the gross, and the Connect transfer that
  // pays the advisor out on release.
  platformFeeCents      Int     @default(0) @map("platform_fee_cents")
  stripeTransferId      String? @map("stripe_transfer_id")

  @@map("payments")
}

model Review {
  id            String   @id @default(cuid())
  bookingId     String   @unique @map("booking_id")
  booking       Booking  @relation(fields: [bookingId], references: [id])
  rating        Int
  writtenReview String?  @map("written_review")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model OutcomeSurvey {
  id               String   @id @default(cuid())
  bookingId        String   @unique @map("booking_id")
  booking          Booking  @relation(fields: [bookingId], references: [id])
  problemAddressed String   @map("problem_addressed") // "yes" | "partially" | "no"
  wouldRebook      Boolean  @map("would_rebook")
  freeTextContext  String?  @map("free_text_context")
  // Nullable now, populated once Phase 2 categorisation exists — added from day one on purpose.
  problemCategory  String?  @map("problem_category")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("outcome_surveys")
}

model Dispute {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  raisedBy  String   @map("raised_by") // user id
  status    String   @default("open") // "open" | "resolved" | "escalated"
  notes     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("disputes")
}

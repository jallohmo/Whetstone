# ---------------------------------------------------------------------------
# Whetstone environment variables
# Copy to .env.local for local dev; set in Vercel (encrypted) for deploys.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ---
# Pooled connection (used by the app at runtime).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma Migrate / introspection).
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (auth, storage, realtime) ---
# Safe to expose client-side — protected by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
# SERVER ONLY. Used for ops invite flow + admin operations. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- Payments (Stripe Connect) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Platform config ---
# Default currency (ISO 4217). Platform is multi-currency; this is the fallback.
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
# Platform commission taken from each booking (basis points, e.g. 1500 = 15%).
PLATFORM_COMMISSION_BPS="1500"
# Static professional-indemnity coverage statement (see 05-technical-foundation §Insurance).
# Insurance is a negotiated blanket policy at MVP, referenced as a config value, not a live API.
INSURANCE_COVERAGE_ACTIVE="true"
INSURANCE_COVERAGE_STATEMENT="Every session is covered by Whetstone's professional indemnity policy, up to the limits set out in our terms."

# --- Video calls (Daily.co) ---
DAILY_API_KEY="[daily-api-key]"

# --- KYC / identity (Stripe Identity or Persona) ---
KYC_PROVIDER="stripe_identity"

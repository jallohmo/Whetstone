# ---------------------------------------------------------------------------
# Whetstone environment variables
# Copy to .env.local for local dev; set in Vercel (encrypted) for deploys.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Wired to Supabase project "whetstone" (ref: yywcerybuaxndsvdkjiw, Sydney).
# The URL + anon key below are the real project values (public-safe by design).
# You must still supply the two SECRETS marked <FROM DASHBOARD> yourself.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ---
# Get the exact strings from: Dashboard -> Project Settings -> Database ->
# "Connection string" -> ORM/Prisma tab (it fills in the pooler host + password).
# The [YOUR-DB-PASSWORD] is the database password you set / can reset there.
DATABASE_URL="postgresql://postgres.yywcerybuaxndsvdkjiw:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma Migrate / introspection).
DIRECT_URL="postgresql://postgres.yywcerybuaxndsvdkjiw:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# --- Supabase (auth, storage, realtime) ---
# Safe to expose client-side — protected by RLS. (Real values for this project.)
NEXT_PUBLIC_SUPABASE_URL="https://yywcerybuaxndsvdkjiw.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl5d2NlcnlidWF4bmRzdmRraml3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNzU1NzAsImV4cCI6MjEwMTY1MTU3MH0.hhULhf8DqxjEkcSl3ZbwCga_aXW6V1-vlEyvO4JEFms"
# SERVER ONLY. Used for ops invite flow + admin operations. Never expose to the client.
# Get from: Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY="<FROM DASHBOARD: service_role key>"

# --- Payments (Stripe Connect) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Platform config ---
# Default currency (ISO 4217). Platform is multi-currency; this is the fallback.
NEXT_PUBLIC_DEFAULT_CURRENCY="AUD"
# Platform commission taken from each booking (basis points, e.g. 1500 = 15%).
PLATFORM_COMMISSION_BPS="1500"
# Static professional-indemnity coverage statement (see 05-technical-foundation §Insurance).
# Insurance is a negotiated blanket policy at MVP, referenced as a config value, not a live API.
INSURANCE_COVERAGE_ACTIVE="true"
INSURANCE_COVERAGE_STATEMENT="Every session is covered by Whetstone's professional indemnity policy, up to the limits set out in our terms."

# --- Video calls (Daily.co) ---
DAILY_API_KEY="[daily-api-key]"

# --- Transactional email (Resend) ---
# SERVER ONLY. Without it, all app emails become logged no-ops (the app still
# works). Get from: resend.com -> API Keys.
RESEND_API_KEY="re_..."
# From-address. Use a VERIFIED sending subdomain (SPF/DKIM/DMARC configured in
# Resend), separate from your root domain to protect its reputation.
EMAIL_FROM="Whetstone <no-reply@mail.whetstone.au>"
# Optional Reply-To for support replies (e.g. support@whetstone.au).
EMAIL_REPLY_TO=""
# Absolute origin used when building links in emails sent outside a request
# (e.g. the Stripe webhook, the session-reminder cron). Falls back to
# https://app.whetstone.au.
NEXT_PUBLIC_SITE_URL="https://app.whetstone.au"

# --- Cron (session reminders + booking lifecycle) ---
# SERVER ONLY. Protects the /api/cron/session-reminders and
# /api/cron/booking-lifecycle endpoints — Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Without it the endpoints refuse every
# request (401). The lifecycle cron is what nudges clients to confirm completed
# work and auto-confirms after 7 days, so advisor payouts stall without it.
CRON_SECRET="<generate a long random string>"

# --- Ops alerts ---
# Optional. Where "a booking was flagged" emails go. Comma-separated for several.
# Leave unset and they go to every OPS_ADMIN account's email instead.
OPS_ALERT_EMAIL=""

# --- KYC / identity (Stripe Identity or Persona) ---
KYC_PROVIDER="stripe_identity"
